{
  "name": "dsh-xiaoshuo",
  "version": "0.1.0",
  "description": "《夜行账房》小说连载流水线插件：给 DSH 提供 10 个 novel_flow_* 工具（状态/续写上下文/剧情档案/写作/审稿/裁决/自动修正/发布/同步/巡检），并在会话里挂一个「连载」面板。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./flow": "./lib/flow.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-better-sidebar",
    "novel",
    "writing",
    "serialization",
    "小说",
    "连载",
    "自动化",
    "teamsx",
    "fanqie"
  ],
  "author": "xiaoxin",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/test-flow.mjs && node test/test-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Mlte0907/dsh-xiaoshuo.git"
  },
  "homepage": "https://github.com/Mlte0907/dsh-xiaoshuo#readme",
  "bugs": {
    "url": "https://github.com/Mlte0907/dsh-xiaoshuo/issues"
  }
}