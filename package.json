{
  "name": "dsh-xiaoshuo",
  "version": "0.1.0",
  "description": "《夜行账房》小说连载流水线：给 agent 提供 7 个 novel_flow_* 工具（状态/上下文/进度/写作/审稿/发布/巡检），并在右侧栏给出一个流水线仪表盘。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./flow": "./lib/flow.js",
    "./package.json": "./package.json"
  },
  "keywords": ["dsh", "dsh-plugin", "dsh-better-sidebar", "novel", "writing", "serialization", "小说", "连载"],
  "author": "xiaoxin",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "scripts": { "test": "node test/test-flow.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["dsh-better-sidebar"] }
  }
}
